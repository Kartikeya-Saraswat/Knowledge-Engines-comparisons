  {
    "id": "JESS103-Q02",
    "question": "How do dams and multi-purpose river projects affect river ecosystems and the surrounding environment?",
    "type": "conceptual",
    "answerable": true,
    "expected_answer": "Dams and river regulation affect the natural flow of rivers, causing poor sediment flow and excessive sedimentation in reservoirs. They fragment rivers, making it difficult for aquatic animals to migrate. Reservoirs submerge existing vegetation and soil. Other consequences include floods, soil erosion, land degradation, water-borne diseases, pollution and soil salinisation resulting from changes in irrigation and cropping patterns.",
    "evidence_units": [
      {
        "id": "E1",
        "relevance": 3,
        "pdf_anchors": [
          {
            "document": "jess103.pdf",
            "pages": [
              5
            ],
            "quote": "Regulating and damming of rivers affect their natural flow causing poor sediment flow and excessive sedimentation at the bottom of the reservoir, resulting in rockier stream beds and poorer habitats for the rivers’ aquatic life."
          }
        ],
        "okf_concept_ids": [
          "KC-JESS103-011"
        ]
      },
      {
        "id": "E2",
        "relevance": 3,
        "pdf_anchors": [
          {
            "document": "jess103.pdf",
            "pages": [
              5
            ],
            "quote": "Dams also fragment rivers making it difficult for aquatic fauna to migrate, especially for spawning."
          }
        ],
        "okf_concept_ids": [
          "KC-JESS103-011"
        ]
      },
      {
        "id": "E3",
        "relevance": 2,
        "pdf_anchors": [
          {
            "document": "jess103.pdf",
            "pages": [
              5
            ],
            "quote": "The reservoirs that are created on the floodplains also submerge the existing vegetation and soil leading to its decomposition over a period of time."
          }
        ],
        "okf_concept_ids": [
          "KC-JESS103-011"
        ]
      },
      {
        "id": "E4",
        "relevance": 2,
        "pdf_anchors": [
          {
            "document": "jess103.pdf",
            "pages": [

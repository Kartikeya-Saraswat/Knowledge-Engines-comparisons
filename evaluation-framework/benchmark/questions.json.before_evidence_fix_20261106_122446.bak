  {
    "id": "JESS103-Q03",
    "question": "How do traditional rainwater harvesting systems in Rajasthan collect and preserve water, and why are underground tankas particularly useful in arid and semi-arid regions?",
    "type": "multi_hop",
    "answerable": true,
    "expected_answer": "Traditional rainwater harvesting in Rajasthan involves collecting rainwater from rooftops and directing it through pipes into underground tanks called tankas. The first spell of rain is generally not collected because it cleans the rooftops and pipes. Subsequent rainfall is stored in the tankas. These tanks preserve water until the next rainfall and provide a reliable source of drinking water during dry periods, particularly in summer when other water sources dry up.",
    "evidence_units": [
      {
        "id": "E1",
        "relevance": 3,
        "pdf_anchors": [
          {
            "document": "jess103.pdf",
            "pages": [
              7
            ],
            "quote": "In the semi-arid and arid regions of Rajasthan, particularly in Bikaner, Phalodi and Barmer, almost all the houses traditionally had underground tanks or tankas for storing drinking water."
          }
        ],
        "okf_concept_ids": [
          "KC-JESS103-009"
        ]
      },
      {
        "id": "E2",
        "relevance": 3,
        "pdf_anchors": [
          {
            "document": "jess103.pdf",
            "pages": [
              8
            ],
            "quote": "Rain falling on the rooftops would travel down the pipe and was stored in these underground ‘tankas’."
          },
          {
            "document": "jess103.pdf",
            "pages": [
              8
            ],
            "quote": "The first spell of rain was usually not collected as this would clean the roofs and the pipes. The rainwater from the subsequent showers was then collected."
          }
        ],
        "okf_concept_ids": [
          "KC-JESS103-009"
        ]
      },
      {
        "id": "E3",
        "relevance": 3,
        "pdf_anchors": [
          {
            "document": "jess103.pdf",
            "pages": [
              8
            ],
            "quote": "The rainwater can be stored in the tankas till the next rainfall making it an extremely reliable source of drinking water when all other sources are dried up, particularly in the summers."
          }
        ],
        "okf_concept_ids": [
          "KC-JESS103-009"
        ]
      }
    ]
  },

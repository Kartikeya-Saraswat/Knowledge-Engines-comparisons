[
  {
    "id": "JESS101-Q01",
    "question": "On what four bases are resources classified, and what are the categories under each basis?",
    "type": "factual",
    "answerable": true,
    "expected_answer": "Resources are classified on four bases: origin (biotic and abiotic), exhaustibility (renewable and non-renewable), ownership (individual, community, national and international), and status of development (potential, developed stock and reserves).",
    "evidence_units": [
      {
        "id": "E1",
        "relevance": 3,
        "pdf_anchors": [
          {
            "document": "jess101.pdf",
            "pages": [
              1
            ],
            "quote": "These resources can be classified in the following ways– (a) On the basis of origin – biotic and abiotic (b) On the basis of exhaustibility – renewable and non-renewable (c) On the basis of ownership – individual, community, national and international (d) On the basis of status of development – potential, developed stock and reserves."
          }
        ],
        "okf_concept_ids": [
          "KC-JESS101-001"
        ]
      }
    ]
  },
  {
    "id": "JESS101-Q02",
    "question": "What major social and environmental problems have resulted from the indiscriminate use and exploitation of resources?",
    "type": "conceptual",
    "answerable": true,
    "expected_answer": "Indiscriminate resource use has caused resource depletion to satisfy the greed of a few individuals, concentration of resources in a few hands leading to rich and poor sections of society, and ecological crises such as global warming, ozone layer depletion, environmental pollution and land degradation.",

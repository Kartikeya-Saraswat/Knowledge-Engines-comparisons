      {
        "id": "E1",
        "relevance": 3,
        "pdf_anchors": [
          {
            "document": "jess103.pdf",
            "pages": [
              2
            ],
            "quote": "Most cases is caused by over-exploitation, excessive use and unequal access to water among different social groups."
          }
        ],

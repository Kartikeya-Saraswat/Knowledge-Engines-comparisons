          "KC-JESS101-003"
        ]
      },
      {
        "id": "E2",
        "relevance": 3,
        "pdf_anchors": [
          {
            "document": "jess101.pdf",
            "pages": [
              2
            ],
            "quote": "Accumulation of resources in few hands, which, in turn, divided the society into two segments i.e. haves and have nots or rich and poor."
          }
